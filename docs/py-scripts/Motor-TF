import numpy as np
import control as ctrl
import matplotlib.pyplot as plt


# ============================================================
# Motor parameters
# ============================================================

R  = 3.9          # Ohm
L  = 2.68e-3      # H
Kt = 0.1125       # Nm/A

# 7.24 V/krpm converted to V/(rad/s)
Ke = 7.24 / 1000.0 * 60.0 / (2.0 * np.pi)

J  = 1.7e-6       # kg*m^2
B  = 1.0e-4       # Nm*s/rad


# ============================================================
# PI velocity controller
# C(s) = Kp + Ki/s
# ============================================================

Kp = 1.0
Ki = 10.0

C_pi = ctrl.TransferFunction([Kp, Ki], [1, 0])


# ============================================================
# Motor plant
#
# Velocity:
#
#             Kt
# Ω(s)/V(s) = -------------------------------
#             LJ s^2 + (LB + RJ)s + RB + KtKe
#
# Position:
#
# Θ(s)/V(s) = Ω(s)/V(s) * 1/s
# ============================================================

plant_vel = ctrl.TransferFunction(
    [Kt],
    [
        L * J,
        L * B + R * J,
        R * B + Kt * Ke
    ]
)

plant_pos = plant_vel * ctrl.TransferFunction([1], [1, 0])


# ============================================================
# Open-loop and closed-loop velocity loop
# ============================================================

L_vel = C_pi * plant_vel
T_vel = ctrl.feedback(L_vel, 1)


# ============================================================
# Helper functions
# ============================================================

def hz(w):
    if w is None or np.isnan(w) or np.isinf(w):
        return float("nan")
    return w / (2.0 * np.pi)


def db(x):
    if x is None or x <= 0 or np.isnan(x) or np.isinf(x):
        return float("nan")
    return 20.0 * np.log10(x)


def safe_metric(value, scale=1.0):
    if value is None or np.isnan(value) or np.isinf(value):
        return float("nan")
    return value * scale


# ============================================================
# Metrics
# ============================================================

gm, pm, wcg, wcp = ctrl.margin(L_vel)
bw = ctrl.bandwidth(T_vel)
info = ctrl.step_info(T_vel)

metrics_text = (
    f"Kp = {Kp:.4g}\n"
    f"Ki = {Ki:.4g}\n"
    f"GM = {db(gm):.2f} dB\n"
    f"PM = {pm:.2f} deg\n"
    f"Wcg = {hz(wcg):.2f} Hz\n"
    f"Wcp = {hz(wcp):.2f} Hz\n"
    f"BW = {hz(bw):.2f} Hz\n"
    f"Rise = {safe_metric(info['RiseTime'], 1000):.2f} ms\n"
    f"Settle = {safe_metric(info['SettlingTime'], 1000):.2f} ms\n"
    f"OS = {info['Overshoot']:.2f} %"
)


# ============================================================
# Console output
# ============================================================

print("\n============================================================")
print("Motor Parameters")
print("============================================================")
print(f"R  = {R:.6g} Ohm")
print(f"L  = {L:.6g} H")
print(f"Kt = {Kt:.6g} Nm/A")
print(f"Ke = {Ke:.6g} V/(rad/s)")
print(f"J  = {J:.6g} kg*m^2")
print(f"B  = {B:.6g} Nm*s/rad")

print("\n============================================================")
print("Transfer Functions")
print("============================================================")
print("\nVelocity plant Ω(s)/Vq(s):")
print(plant_vel)
print("\nPosition plant Θ(s)/Vq(s):")
print(plant_pos)
print("\nPI controller C(s):")
print(C_pi)
print("\nOpen loop L(s) = C(s)P(s):")
print(L_vel)
print("\nClosed loop T(s) = L(s)/(1+L(s)):")
print(T_vel)

print("\n============================================================")
print("Metrics")
print("============================================================")
print(metrics_text)


# ============================================================
# Closed-loop velocity step response
# ============================================================

t, y = ctrl.step_response(T_vel)

plt.figure()
plt.plot(t, y)
plt.grid(True)
plt.xlabel("Time [s]")
plt.ylabel("Velocity response [normalized]")
plt.title("Closed-Loop Velocity Step Response")

plt.text(
    0.98, 0.02,
    metrics_text,
    transform=plt.gca().transAxes,
    fontsize=10,
    verticalalignment="bottom",
    horizontalalignment="right",
    bbox=dict(boxstyle="round", alpha=0.85)
)


# ============================================================
# Open-loop Bode with automatic margin display
# ============================================================

plt.figure()
ctrl.bode_plot(
    L_vel,
    dB=True,
    Hz=True,
    deg=True,
    grid=True,
    display_margins=True
)
plt.suptitle("Open-Loop Bode: PI Controller × Velocity Plant")


# ============================================================
# Closed-loop Bode
# ============================================================

plt.figure()
ctrl.bode_plot(
    T_vel,
    dB=True,
    Hz=True,
    deg=True,
    grid=True
)
plt.suptitle("Closed-Loop Bode: Velocity Command → Velocity Feedback")


# ============================================================
# Optional: position plant Bode
# ============================================================

plt.figure()
ctrl.bode_plot(
    plant_pos,
    dB=True,
    Hz=True,
    deg=True,
    grid=True
)
plt.suptitle("Open-Loop Plant Bode: Position / Voltage")


plt.show()